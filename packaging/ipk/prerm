#!/bin/sh
# opkg prerm: runs BEFORE the package payload is removed.
# Stop the daemon so it is not left running from a binary that is about to be
# deleted. postinst restarts it after an upgrade; postrm restarts the stock
# daemon after a removal.

if [ -x /etc/init.d/charge.init ]; then
	/etc/init.d/charge.init stop >/dev/null 2>&1 || true
fi

exit 0
